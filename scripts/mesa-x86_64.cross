# Meson cross file: build Mesa for x86_64 macOS (Wine runs under Rosetta) on an
# Apple Silicon host. pkg-config is off so no arm64 Homebrew library slips in;
# zlib and expat come from the macOS SDK, which ships them for both arches.
[binaries]
c = ['clang', '-arch', 'x86_64']
cpp = ['clang++', '-arch', 'x86_64']
objc = ['clang', '-arch', 'x86_64']
objcpp = ['clang++', '-arch', 'x86_64']
ar = 'ar'
strip = 'strip'
pkg-config = 'false'

[host_machine]
system = 'darwin'
cpu_family = 'x86_64'
cpu = 'x86_64'
endian = 'little'
