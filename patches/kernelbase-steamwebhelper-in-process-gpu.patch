+/***********************************************************************
+ *           get_steamwebhelper_cmdline
+ *
+ * HACK: Chromium composites from its GPU process into a window owned by the
+ * browser process.  The Mac driver can't show drawing done by another
+ * process, so Steam's web helper comes up black; keep the GPU thread in the
+ * browser process.  Child processes carry --type= and are left alone.
+ */
+static WCHAR *get_steamwebhelper_cmdline( const WCHAR *app_name, const WCHAR *cmdline )
+{
+    static const WCHAR arg[] = L" --in-process-gpu";
+    const WCHAR *base = app_name, *s;
+    WCHAR *ret;
 
+    for (s = app_name; *s; s++)
+        if (*s == '\\' || *s == '/') base = s + 1;
+    if (wcsicmp( base, L"steamwebhelper.exe" )) return NULL;
+    if (wcsstr( cmdline, L"--type=" ) || wcsstr( cmdline, arg + 1 )) return NULL;
+
+    if (!(ret = RtlAllocateHeap( GetProcessHeap(), 0, (lstrlenW( cmdline ) + ARRAY_SIZE(arg)) * sizeof(WCHAR) )))
+        return NULL;
+    lstrcpyW( ret, cmdline );
+    lstrcatW( ret, arg );
+    TRACE( "steamwebhelper cmdline %s\n", debugstr_w(ret) );
+    return ret;
+}
